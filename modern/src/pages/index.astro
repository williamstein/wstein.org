---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout bodyClass="home-page">
  <main>
    <section class="home-hero" aria-labelledby="home-title">
      <img class="home-hero__image" src="/william-fsg-svr.jpg" alt="William Stein skateboarding vert" />
      <div class="home-hero__shade"></div>
      <div class="home-hero__content">
        <p class="eyebrow eyebrow--light">Software builder &middot; Mathematician &middot; Vert skateboarder</p>
        <h1 id="home-title">William A. Stein</h1>
        <p>I build tools for collaborative computation, write mathematical software, and preserve the work and photographs collected on this site since the 1990s.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#work">Current work</a>
          <a class="button button--ghost" href="/pics/">Photo archive</a>
        </div>
      </div>
    </section>

    <section class="band band--work" id="work" aria-labelledby="work-title">
      <div class="page-width work-layout">
        <div class="section-heading">
          <p class="eyebrow">Current work</p>
          <h2 id="work-title">Open tools for serious computation</h2>
          <p>Founder and CEO of SageMath, Inc. I lead the development of CoCalc and have worked on SageMath and open mathematical computing for two decades.</p>
        </div>
        <div class="work-list">
          <a class="work-item" href="https://cocalc.com">
            <span class="work-item__index">01</span>
            <span><strong>CoCalc</strong><small>Collaborative calculation and computing in the cloud</small></span>
            <span class="arrow" aria-hidden="true">&nearr;</span>
          </a>
          <a class="work-item" href="https://www.sagemath.org/">
            <span class="work-item__index">02</span>
            <span><strong>SageMath</strong><small>Open-source mathematics software</small></span>
            <span class="arrow" aria-hidden="true">&nearr;</span>
          </a>
          <a class="work-item" href="https://github.com/williamstein">
            <span class="work-item__index">03</span>
            <span><strong>Software</strong><small>Current and historical projects on GitHub</small></span>
            <span class="arrow" aria-hidden="true">&nearr;</span>
          </a>
        </div>
      </div>
    </section>

    <section class="band" aria-labelledby="math-title">
      <div class="page-width">
        <div class="section-heading section-heading--row">
          <div>
            <p class="eyebrow">Mathematics</p>
            <h2 id="math-title">Writing, teaching, and computation</h2>
          </div>
          <p>The public record of my research and teaching, from books and papers to decades of slides and computational data.</p>
        </div>
        <div class="topic-grid">
          <a class="topic" href="/research/"><span>Overview</span><h3>Research</h3><p>Guides to modular forms, arithmetic geometry, and open computation.</p></a>
          <a class="topic topic--gold" href="/papers/"><span>Writing</span><h3>Papers</h3><p>Fifty papers, preprints, and long-form research projects.</p></a>
          <a class="topic topic--red" href="/books/"><span>Long form</span><h3>Books</h3><p>Open texts, source material, and published books.</p></a>
          <a class="topic topic--blue" href="/talks/"><span>Archive</span><h3>Talks</h3><p>Slides and supporting files spanning nearly two decades.</p></a>
          <a class="topic topic--red" href="/projects/"><span>Mentoring</span><h3>Projects</h3><p>Student theses, junior papers, and directed course work.</p></a>
          <a class="topic" href="/Tables/"><span>Data</span><h3>Tables</h3><p>The historical modular forms and elliptic curves database.</p></a>
        </div>
      </div>
    </section>

    <section class="band band--personal" aria-labelledby="archive-title">
      <div class="page-width personal-layout">
        <a class="personal-photo" href="/pics/new/">
          <img src="/bella-and-william.jpg" alt="William Stein with Bella outdoors" />
        </a>
        <div>
          <p class="eyebrow">Beyond the work</p>
          <h2 id="archive-title">A personal web archive</h2>
          <p>This site has accumulated photographs, travel, teaching, old projects, hardware notes, and snapshots of the early mathematical web for several decades.</p>
          <div class="text-links">
            <a href="/pics/">Browse photographs</a>
            <a href="https://vertramp.org/">Vert skateboarding</a>
            <a href="/courses/">Courses</a>
            <a href="/projects/">Student projects</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
